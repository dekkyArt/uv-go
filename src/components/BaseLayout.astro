---
import '../styles/global.css';
import ThemeScript from './ThemeScript.astro';
import SkyScript from './SkyScript.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Used by SeoHead in Task 23. */
  ogImage: string;
  /** Used by SeoHead in Task 23. */
  jsonLd?: object[];
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <SkyScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col font-sans text-text antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
