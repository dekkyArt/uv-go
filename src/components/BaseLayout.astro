---
import '../styles/global.css';
import SkyScript from './SkyScript.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import SeoHead from './SeoHead.astro';
import { siteConfig } from '../site.config';

interface Props {
  title: string;
  description: string;
  /** Site-relative path of the 1200x630 OG image, e.g. `/og/home.png`. */
  ogImage: string;
  jsonLd?: object[];
  noindex?: boolean;
  /** The page has the fixed bottom toolbar (the home page): the footer leaves room for it. */
  withToolbar?: boolean;
}

const { title, description, ogImage, jsonLd, noindex, withToolbar } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.site).href;
const ogImageUrl = new URL(ogImage, siteConfig.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SkyScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImageUrl}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body class="font-sans text-text antialiased">
    <div data-page class="relative flex min-h-screen flex-col">
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2"
      >
        Skip to content
      </a>
      <Header />
      {/* The header floats over the top of the page: main leaves room for its row (64 px) or, below
          360 px where the nav pill wraps under the logo, for its two rows. */}
      <main
        id="main"
        class="mx-auto w-full max-w-[1200px] flex-1 px-4 pb-6 pt-[7.5rem] min-[360px]:pt-16"
      >
        <slot />
      </main>
      <Footer withToolbar={withToolbar} />
    </div>
  </body>
</html>
