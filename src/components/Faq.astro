---
import { faqItems } from '../content/faq';
---

<section aria-labelledby="faq-heading" class="reveal glass mt-8 rounded-[22px] p-4 sm:p-6">
  <h2 id="faq-heading" class="text-[22px] font-semibold leading-7 text-text">
    Questions and answers
  </h2>

  <div class="mt-4 divide-y divide-white/15">
    {faqItems.map((item) => (
      <details class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 rounded-lg py-3 font-semibold text-text [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <span
            aria-hidden="true"
            class="shrink-0 text-xl leading-none text-text-muted transition-transform group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="pb-4 text-text-muted">{item.a}</p>
      </details>
    ))}
  </div>

  <nav aria-label="Background reading" class="mt-4">
    <p class="text-text-muted">Want the background?</p>
    <ul class="flex flex-wrap gap-x-5">
      <li>
        <a
          class="inline-flex min-h-11 items-center font-medium text-focus underline underline-offset-2"
          href="/uv-index"
        >
          The UV index
        </a>
      </li>
      <li>
        <a
          class="inline-flex min-h-11 items-center font-medium text-focus underline underline-offset-2"
          href="/uv-risks"
        >
          UV risks
        </a>
      </li>
      <li>
        <a
          class="inline-flex min-h-11 items-center font-medium text-focus underline underline-offset-2"
          href="/sun-protection"
        >
          Sun protection
        </a>
      </li>
    </ul>
  </nav>
</section>
