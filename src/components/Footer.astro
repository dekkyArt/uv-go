---
import { siteConfig } from '../site.config';
import { TOOLBAR_H } from '../app/ui';
import { measurementId } from '../analytics/consent';

interface Props {
  /** The page has the fixed bottom toolbar (the home page, on a phone): leave room for it under the footer. */
  withToolbar?: boolean;
}

const { withToolbar = false } = Astro.props;
const linkClass = 'underline underline-offset-2 hover:text-white/80';
---

<!-- The toolbar is a phone's only: desktop keeps the plain padding. -->
<footer
  class:list={['px-4 pb-6 pt-8', withToolbar && 'max-lg:pb-(--toolbar-space)']}
  style={
    withToolbar
      ? `--toolbar-space: calc(${TOOLBAR_H}px + 24px + env(safe-area-inset-bottom))`
      : undefined
  }
>
  <div class="mx-auto flex max-w-[1200px] flex-col gap-1 px-4 py-4 text-[13px] leading-tight text-white">
    <p class="flex flex-wrap items-center gap-x-1">
      <span>Weather data by</span>
      <a class={linkClass} href="https://open-meteo.com/" rel="noopener">
        Open-Meteo.com
      </a>
    </p>
    <p class="flex flex-wrap items-center gap-x-4">
      <a class={linkClass} href={siteConfig.repoUrl} rel="noopener">
        GitHub
      </a>
      <span class="inline-flex flex-wrap items-center gap-x-1">
        <span>Designed &amp; built by</span>
        <a class={linkClass} href={siteConfig.author.url} rel="noopener">
          {siteConfig.author.name}
        </a>
      </span>
    </p>
    <p class="flex flex-wrap items-center gap-x-4">
      <a class={linkClass} href="/about/">
        About UV GO
      </a>
      <a class={linkClass} href="/methodology/">
        How we choose your time
      </a>
      <a class={linkClass} href="/privacy/">
        Privacy &amp; cookies
      </a>
      {measurementId(import.meta.env.PUBLIC_GA_MEASUREMENT_ID) && (
        <button
          type="button"
          data-analytics-settings
          class={`${linkClass} min-h-11 cursor-pointer`}
        >
          Cookie settings
        </button>
      )}
    </p>
    <p>UV GO gives general guidance, not medical advice.</p>
  </div>
</footer>
