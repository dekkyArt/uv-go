---
const links = [
  { href: '/uv-index', label: 'UV Index' },
  { href: '/uv-risks', label: 'Risks' },
  { href: '/sun-protection', label: 'Protection' },
];

// Each pill is its own glass, so the link text keeps its contrast whatever the sky is doing
// behind it (the sun can sit in the top zone, spec 6.4).
const pill =
  'glass inline-flex min-h-11 items-center rounded-full text-[15px] font-semibold text-text';
---

<header>
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-2 px-4 pt-3">
    <a href="/" class={`${pill} px-3`}>
      UV GO
    </a>
    <nav aria-label="Main" class={`${pill} px-1`}>
      {links.map((link) => (
        <a
          href={link.href}
          class="inline-flex min-h-11 min-w-11 items-center justify-center px-2 hover:underline"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
