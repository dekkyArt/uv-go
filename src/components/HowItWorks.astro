---
// Rule tables are generated from `rules` (spec 6, 11.4): a threshold changed in
// rules.config.ts changes this page. No number about scoring is typed here.
import { INSET_CLASS } from '../app/ui';
import { rules } from '../domain/rules.config';
import type { ChecklistId } from '../domain/types';

const { uv, rain, heat, cold, wind, verdict, checklist, checklistLabels, verdictLabels } = rules;

/** "3–5" for a band that ends before the next one, "8+" for the last. */
function range(bands: readonly { min: number }[], index: number, suffix = ''): string {
  const min = bands[index]!.min;
  const next = bands[index + 1]?.min;
  if (next === undefined) return `${min}${suffix}+`;
  if (next - 1 === min) return `${min}${suffix}`;
  return `${min}–${next - 1}${suffix}`;
}

const trim = (n: number) => String(Number(n.toFixed(2)));
const longSun = uv.multiplier['long-sun'];

const uvRows = uv.bands.map((band, i) => ({
  range: range(uv.bands, i),
  points: band.points,
  longSun: trim(band.points * longSun),
}));

const rainRows = [
  { range: `Under ${rain.bands[0]!.min}%`, points: 0 },
  ...rain.bands.map((band, i) => ({ range: range(rain.bands, i, '%'), points: band.points })),
];

const otherRows = [
  {
    factor: 'Heat',
    condition: `Feels like ${heat.min}°C or more`,
    points: `+${heat.points}`,
    note: `+${heat.pointsByActivity.active} for Active`,
  },
  {
    factor: 'Cold',
    condition: `Feels like below ${cold.below}°C`,
    points: `+${cold.points}`,
    note: '',
  },
  {
    factor: 'Wind',
    condition: `Wind ${wind.min} km/h or more`,
    points: `+${wind.points}`,
    note: '',
  },
];

const verdictRows = verdict.bands.map((band, i) => ({
  range: range(verdict.bands, i),
  tone: band.verdict,
  label: verdictLabels[band.verdict],
}));

// The verdict words are white, like every other cell: the chip carries the colour.
const chip = {
  green: 'bg-verdict-green',
  yellow: 'bg-verdict-yellow',
  red: 'bg-verdict-red',
} as const;

const checklistWhen: Record<ChecklistId, string> = {
  sunscreen: `The highest rounded UV in your window is ${checklist.sunscreenUv} or more`,
  'hat-sunglasses': `The highest rounded UV in your window is ${checklist.hatUv} or more`,
  'rain-jacket': `At least one hour has a ${checklist.rainJacket}% or higher chance of rain`,
  water: `You picked Active, or at least one hour feels like ${checklist.waterFeelsLike}°C or more`,
  'warm-layer': `At least one hour feels like below ${checklist.warmLayerBelow}°C`,
};
const checklistRows = (Object.entries(checklistLabels) as [ChecklistId, string][]).map(
  ([id, label]) => ({ label, when: checklistWhen[id] }),
);

const steps = [
  {
    title: 'Pick a place',
    text: 'Search for a city or use your current location. UV GO saves the selected place in your browser when storage is available.',
  },
  {
    title: 'Set your time',
    text: 'Choose today or tomorrow, the hours you are free, how long you will be out and what you will be doing.',
  },
  {
    title: 'Get one answer',
    text: 'When a daylight window fits, you see the lowest-scoring time, its verdict, a short explanation and suggested items to take. Even the best window can be Not recommended.',
  },
];

// Rows like the Your free time table (spec 4.4): 44 px tall, hairline dividers.
const tableWrap = 'mt-3 overflow-x-auto';
const table = 'w-full border-collapse text-left text-base';
const headRow = 'h-11 border-b border-white/15 text-sm text-text-muted';
const bodyRow = 'h-11 border-b border-white/15 last:border-b-0';
const th = 'py-2 pr-4 font-semibold';
const rowHead = 'py-2 pr-4 font-semibold text-text';
const td = 'py-2 pr-4 text-text';
const h3 = 'mt-8 text-[17px] font-semibold text-text';
---

<section
  id="how-it-works"
  tabindex="-1"
  aria-labelledby="how-heading"
  class="reveal glass mt-8 scroll-mt-32 rounded-[22px] p-4 sm:p-6"
>
  <h2 id="how-heading" class="text-[22px] font-semibold leading-7 text-text">
    How it works
  </h2>

  <ol class="mt-4 grid gap-3 sm:grid-cols-3">
    {/* The plate lightens the glass, so its text is full white: secondary white would fall under AA. */}
    {steps.map((step, i) => (
      <li class={`rounded-xl ${INSET_CLASS} p-4`}>
        <span
          aria-hidden="true"
          class={`inline-flex size-8 items-center justify-center rounded-full ${INSET_CLASS} text-sm font-semibold text-text`}
        >
          {i + 1}
        </span>
        <h3 class="mt-2 text-[17px] font-semibold text-text">{step.title}</h3>
        <p class="mt-1 text-text">{step.text}</p>
      </li>
    ))}
  </ol>

  <h3 class={h3}>The rules behind the answer</h3>
  <p class="mt-1 text-text-muted">
    Each forecast hour gets points for UV, chance of rain, heat, cold and wind. Lower is better. A
    window is scored as the average of its hours. UV GO compares the exact averages; ties go to the
    window with the lowest worst-hour score, then the earliest start.
  </p>
  <p class="mt-3 text-text-muted">
    Windows start on the hour and must fit inside your free time. Every included hour must be marked
    as daytime in the forecast. For today, starts before the current time are excluded: at 14:10,
    the earliest start is 15:00. All times use the chosen place’s local time.
  </p>
  <p class="mt-3 text-text-muted">
    A 30-minute outing needs a full hour inside your free time and uses the same forecast as a
    1-hour outing, but its result ends after 30 minutes. Outings of 2 or 3 hours use 2 or 3
    consecutive forecast hours. UV GO does not calculate daylight eligibility minute by minute from
    sunrise and sunset.
  </p>
  <p class="mt-3 text-text-muted">
    Active adds more heat points and always suggests water. Relaxed uses the standard points. Long
    in the sun increases UV points; duration is chosen separately.
  </p>

  <h3 class={h3}>UV</h3>
  <p class="mt-1 text-text-muted">
    UV is rounded to the nearest whole number first, with .5 rounded up. For Long in the sun, UV
    points are multiplied by <span class="font-semibold text-text">× {longSun}</span>.
  </p>
  <div class={tableWrap}>
    <table class={table}>
      <caption class="sr-only">Points by UV index</caption>
      <thead>
        <tr class={headRow}>
          <th scope="col" class={th}>
            UV index
          </th>
          <th scope="col" class={th}>
            Points
          </th>
          <th scope="col" class={th}>
            Long in the sun
          </th>
        </tr>
      </thead>
      <tbody>
        {uvRows.map((row) => (
          <tr class={bodyRow}>
            <th scope="row" class={rowHead}>
              {row.range}
            </th>
            <td class={td}>{row.points}</td>
            <td class={td}>{row.longSun}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 class={h3}>Rain</h3>
  <div class={tableWrap}>
    <table class={table}>
      <caption class="sr-only">Points by chance of rain</caption>
      <thead>
        <tr class={headRow}>
          <th scope="col" class={th}>
            Chance of rain
          </th>
          <th scope="col" class={th}>
            Points
          </th>
        </tr>
      </thead>
      <tbody>
        {rainRows.map((row) => (
          <tr class={bodyRow}>
            <th scope="row" class={rowHead}>
              {row.range}
            </th>
            <td class={td}>{row.points}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 class={h3}>Heat, cold and wind</h3>
  <p class="mt-1 text-text-muted">
    Heat and cold use the feels-like temperature, which includes wind and humidity.
  </p>
  <div class={tableWrap}>
    <table class={table}>
      <caption class="sr-only">Points for heat, cold and wind</caption>
      <thead>
        <tr class={headRow}>
          <th scope="col" class={th}>
            Factor
          </th>
          <th scope="col" class={th}>
            When
          </th>
          <th scope="col" class={th}>
            Points
          </th>
        </tr>
      </thead>
      <tbody>
        {otherRows.map((row) => (
          <tr class={bodyRow}>
            <th scope="row" class={rowHead}>
              {row.factor}
            </th>
            <td class={td}>{row.condition}</td>
            <td class={td}>
              {row.points}
              {row.note !== '' && <span class="block text-sm text-text-muted">{row.note}</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 class={h3}>Verdict</h3>
  <p class="mt-1 text-text-muted">
    The average window score is rounded to the nearest whole number, with .5 rounded up, then
    matched to a verdict. Hourly verdicts use that hour’s score. The best window can still have a
    red verdict.
  </p>
  <div class={tableWrap}>
    <table class={table}>
      <caption class="sr-only">Verdict by window score</caption>
      <thead>
        <tr class={headRow}>
          <th scope="col" class={th}>
            Window score
          </th>
          <th scope="col" class={th}>
            Verdict
          </th>
        </tr>
      </thead>
      <tbody>
        {verdictRows.map((row) => (
          <tr class={bodyRow}>
            <th scope="row" class={rowHead}>
              {row.range}
            </th>
            <td class={`${td} font-semibold`}>
              <span class="inline-flex items-center gap-2">
                <span aria-hidden="true" class={`size-4 shrink-0 rounded-full ${chip[row.tone]}`} />
                {row.label}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 class={h3}>The short explanation</h3>
  <p class="mt-1 text-text-muted">
    The reason line shows up to two factors that add the most points across the chosen window. It
    uses the highest available UV, chance of rain, heat or wind value, or the lowest feels-like
    temperature for cold. It describes the selected window; it does not compare it with other
    windows. When no factor adds points, it says “{rules.reasonTemplates.none}”.
  </p>

  <h3 class={h3}>What to take</h3>
  <p class="mt-1 text-text-muted">
    The checklist uses the highest or lowest available values across the forecast hours of your best
    window. “{rules.emptyChecklistText}” means none of these rules triggered with the available
    data.
  </p>
  <div class={tableWrap}>
    <table class={table}>
      <caption class="sr-only">When each item appears on the checklist</caption>
      <thead>
        <tr class={headRow}>
          <th scope="col" class={th}>
            Item
          </th>
          <th scope="col" class={th}>
            Appears when
          </th>
        </tr>
      </thead>
      <tbody>
        {checklistRows.map((row) => (
          <tr class={bodyRow}>
            <th scope="row" class={rowHead}>
              {row.label}
            </th>
            <td class={td}>{row.when}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 class={h3}>Reading the forecast</h3>
  <p class="mt-1 text-text-muted">
    Hourly shows all 24 hours. Switch between UV, chance of rain and feels-like temperature, and
    select an hour for its values and points. The shaded band marks your free time; the outline
    marks the forecast hours used for the best window. Your free time lists those hours with
    individual verdicts. A longer bar means more points, and Best marks hours in the chosen window.
    Those hourly verdicts can differ from the window’s average verdict.
  </p>
  <p class="mt-3 text-text-muted">
    Now shows the current hour’s forecast, rather than a live measurement. Tomorrow’s summary shows
    peak UV and the feels-like range across all forecast daylight hours, rather than just your
    chosen window. A dash or “no data” means a forecast value is missing. Missing factors add no
    points and cannot trigger checklist items, so a low score can reflect incomplete data.
  </p>
  <h3 class={h3}>When no window fits</h3>
  <p class="mt-1 text-text-muted">
    Extend your free time or shorten the outing if it does not fit. If no daylight window fits,
    change the hours or duration. When a forecast loads and all eligible starts today have passed,
    UV GO switches to tomorrow. Choose Today again to keep viewing today for the rest of the
    session. Changing the plan recalculates the result immediately; Done closes the Plan panel.
  </p>
</section>
