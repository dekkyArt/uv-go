---
// Runs in <head> before first paint so the page never flashes the wrong theme.
// `is:inline` scripts cannot import modules, so the resolveTheme algorithm is
// duplicated here. Keep in sync with resolveTheme() in src/app/theme.ts.
---

<script is:inline>
  (function () {
    var stored = null;
    var systemDark = false;
    try {
      stored = localStorage.getItem('uvgo:theme');
    } catch (e) {}
    try {
      systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    } catch (e) {}
    var theme = stored === 'light' || stored === 'dark' ? stored : systemDark ? 'dark' : 'light';
    document.documentElement.dataset.theme = theme;
  })();
</script>
