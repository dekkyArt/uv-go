---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | UV GO"
  description="This page does not exist. Go back to UV GO and find the best time to go outside based on the UV forecast for your location."
  ogImage="/og/home.png"
  noindex
>
  <section class="sky-panel mx-auto max-w-xl rounded-2xl px-5 py-8 text-center sm:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-text">Page not found</h1>
    <p class="mt-3 text-text-muted">We could not find the page you were looking for.</p>
    <p class="mt-6">
      <a
        href="/"
        class="inline-flex min-h-11 items-center rounded-xl border border-border bg-surface-strong px-5 font-bold text-text hover:bg-surface"
      >
        Back to UV GO
      </a>
    </p>
  </section>
</BaseLayout>
