---
import BaseLayout from '../components/BaseLayout.astro';
import UvGoApp from '../app/UvGoApp';
import { reservePlaceLayout } from '../app/reservePlaceLayout';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Faq from '../components/Faq.astro';
---

<BaseLayout
  title="UV GO"
  description="Find the best time to go outside based on the UV forecast for your location."
  ogImage="/og/home.png"
>
  <Hero />
  <script is:inline set:html={`(${reservePlaceLayout})()`} />
  <UvGoApp client:load />
  <HowItWorks />
  <Faq />
</BaseLayout>
