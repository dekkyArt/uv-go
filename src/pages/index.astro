---
import BaseLayout from '../components/BaseLayout.astro';
import UvGoApp from '../app/UvGoApp';
import { reserveLayout } from '../app/reserveLayout';
import { BOOT_MAX_MS, BOOT_OUT_MS, startBoot } from '../app/boot';
import BootSplash from '../components/BootSplash.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Faq from '../components/Faq.astro';
import { siteConfig } from '../site.config';
import { faqItems } from '../content/faq';
import { faqPageLd, webApplicationLd, websiteLd } from '../seo/jsonld';
---

<BaseLayout
  title="Best Time to Go Outside Today — UV & Weather Planner"
  description="Plan an outing today or tomorrow. Set your place, free hours, duration and activity. UV GO compares daylight windows using the hourly UV and weather forecast."
  ogImage="/og/home.png"
  withToolbar
  jsonLd={[webApplicationLd(siteConfig.site), websiteLd(siteConfig.site), faqPageLd(faqItems)]}
>
  <BootSplash />
  <script
    is:inline
    set:html={`(${reserveLayout})();(${startBoot})(${BOOT_MAX_MS},${BOOT_OUT_MS})`}
  />
  <UvGoApp client:load />
  <HowItWorks />
  <Faq />
</BaseLayout>
