---
import BaseLayout from '../components/BaseLayout.astro';
import UvGoApp from '../app/UvGoApp';
import { reserveLayout } from '../app/reserveLayout';
import HowItWorks from '../components/HowItWorks.astro';
import Faq from '../components/Faq.astro';
import { siteConfig } from '../site.config';
import { faqItems } from '../content/faq';
import { faqPageLd, webApplicationLd } from '../seo/jsonld';
---

<BaseLayout
  title="Best Time to Go Outside Today — UV & Weather Planner"
  description="Pick your free time and place. UV GO reads the hourly UV and weather forecast, finds the best hour to go outside and tells you what to take with you."
  ogImage="/og/home.png"
  jsonLd={[webApplicationLd(siteConfig.site), faqPageLd(faqItems)]}
>
  <script is:inline set:html={`(${reserveLayout})()`} />
  <UvGoApp client:load />
  <HowItWorks />
  <Faq />
</BaseLayout>
